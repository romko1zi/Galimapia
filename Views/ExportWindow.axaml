<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Galimapia.Views.ExportWindow"
        Title="Export"
        Width="460"
        Height="340"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1C1B19">
    <StackPanel Margin="24" Spacing="12">
        <StackPanel x:Name="Setup" Spacing="10">
            <TextBlock Text="Format" FontFamily="Consolas" FontSize="13" Foreground="#C8C2B8" />
            <ComboBox x:Name="FormatBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="PDF" />
                <ComboBoxItem Content="JPEG" />
                <ComboBoxItem Content="PNG" />
                <ComboBoxItem Content="Map tiles" />
            </ComboBox>
            <TextBlock Text="Quality" FontFamily="Consolas" FontSize="13" Foreground="#C8C2B8" />
            <ComboBox x:Name="QualityBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Screen, 2048 px" />
                <ComboBoxItem Content="Print, 4096 px" />
                <ComboBoxItem Content="Fine, 8192 px" />
            </ComboBox>
            <TextBlock x:Name="Hint" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Foreground="#8A8378" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="CancelSetupButton" Content="Cancel" MinWidth="88" />
                <Button x:Name="StartButton" Content="Export" MinWidth="88" />
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="Running" Spacing="10" IsVisible="False">
            <TextBlock x:Name="Detail" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Foreground="#E6D7C3" />
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="16" />
            <TextBlock x:Name="Percent" FontFamily="Consolas" FontSize="13" Foreground="#C8C2B8" Text="0%" />
            <Button x:Name="StopButton" Content="Stop" MinWidth="88" HorizontalAlignment="Right" />
        </StackPanel>
    </StackPanel>
</Window>
